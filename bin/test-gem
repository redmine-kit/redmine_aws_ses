#!/usr/bin/env bash
# The plugin as a gem, in Apple container when it runs, else in Docker
# (CONTAINER_CLI=container|docker chooses): builds the gems of this checkout and of
# redmine_kit_aws, which it depends on, installs them into Redmine 7.0.3 as
# docs/setup.md#gem says (a gem line in Gemfile.local, then plugins/ linked
# to the installed gems), and boots Redmine through zeitwerk:check and in the
# production environment, which loads every file at start-up (eager_load).
# It fails when the gem misses a file that the checkout has.
#   bin/test-gem
#   TEST_RUBY=3.2 bin/test-gem   # on Ruby 3.2 (default 4.0)
#   REDMINE_KIT_AWS_DIR=<dir> bin/test-gem   # redmine_kit_aws from <dir> (default ../redmine_kit_aws)
# Commands that run inside the container are in single quotes on purpose.
# shellcheck disable=SC2016
set -euo pipefail
cd "$(dirname "$0")/.."
source bin/container_cli
source bin/test_slot
name=redmine-kit-aws-ses-test
stop_services_at_exit "$name"
bin/services >/dev/null
# test/Dockerfile as bin/test builds it.
source bin/test_image
if [[ "$cli" == docker ]]; then
  net=(--network "${name}_default")
else
  net=(--network "$kit_test_network" -m 4G -e TEST_DATABASE_HOST="$(container_address "$name-postgres" "$kit_test_network")")
fi
# A database of this run's own, dropped at the end.
"$cli" run --rm "${run_opts[@]}" "${net[@]}" -e TEST_DATABASE="redmine_test_$$" "$image" sh -ec '
  # without redmine_kit_ui, which bin/test_image adds for bin/test: the gem alone
  mv plugins/redmine_kit_ui /tmp/ && mkdir plugins/kit_ui_gems && cp /tmp/redmine_kit_ui/Gemfile plugins/kit_ui_gems/
  for plugin in redmine_kit_aws redmine_kit_aws_ses; do
    (cd "plugins/$plugin" && gem build --quiet "$plugin.gemspec" --output "/tmp/$plugin.gem")
    rm -r "plugins/$plugin"
  done
  gem install --local --no-document --quiet /tmp/redmine_kit_aws.gem /tmp/redmine_kit_aws_ses.gem
  printf "%s\n" "gem '\''redmine_kit_aws_ses'\''" "gem '\''simplecov-cobertura'\'', group: :test" > Gemfile.local
  bundle install --prefer-local --quiet
  for plugin in redmine_kit_aws redmine_kit_aws_ses; do
    ln -s "$(bundle info --path "$plugin")" "plugins/$plugin"
  done
  bin/rails db:drop db:create db:migrate redmine:plugins:migrate >/dev/null
  bin/rails zeitwerk:check
  # The production environment, which loads every file at start-up
  # (eager_load), on the test database.
  printf "%s\n" "production:" "  adapter: postgresql" "  host: ${TEST_DATABASE_HOST:-postgres}" "  database: $TEST_DATABASE" \
    "  username: postgres" >> config/database.yml
  RAILS_ENV=production SECRET_KEY_BASE=test-gem bin/rails runner "
    plugin = Redmine::Plugin.find(:redmine_kit_aws_ses)
    dir = File.realpath(plugin.directory)
    abort %(redmine_kit_aws_ses is not the installed gem: #{dir}) unless dir.start_with?(Gem.dir)
    abort %(not eager loaded) unless Rails.application.config.eager_load
    puts %(redmine_kit_aws_ses #{plugin.version} from #{dir}: RedmineKit::Aws::Ses #{RedmineKit::Aws::Ses::VERSION})"
  bin/rails db:drop >/dev/null'
