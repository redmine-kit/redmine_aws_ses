#!/usr/bin/env bash
# Starts PostgreSQL 16, AWS Emulator and moto for the tests (and LocalStack
# when LOCALSTACK_AUTH_TOKEN is set; test/compose.yml), or stops them with
# --down.
set -euo pipefail
cd "$(dirname "$0")/.."
compose=(docker compose -f test/compose.yml -p redmine-aws-ses-test)
if [[ -n "${LOCALSTACK_AUTH_TOKEN:-}" ]]; then
  compose+=(--profile localstack)
fi
if [[ "${1:-}" == "--down" ]]; then
  "${compose[@]}" down -v
  exit 0
fi
if ! "${compose[@]}" up -d --wait; then
  "${compose[@]}" ps -a >&2
  "${compose[@]}" logs --tail 80 >&2
  exit 1
fi
