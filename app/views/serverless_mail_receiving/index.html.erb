<%= render partial: 'serverless_admin/tabs', locals: { selected: 'mail_receiving' } %>

<h3><%= l(:label_serverless_mail_addresses) %></h3>
<% if @domain.nil? %>
  <p class="warning"><%= l(:text_serverless_mail_no_domain) %></p>
<% else %>
<table class="list serverless-mail-addresses">
  <tbody>
    <tr><th><%= l(:label_serverless_mail_domain) %></th><td><%= @domain %></td></tr>
    <tr><th><%= l(:label_serverless_mail_global_address) %></th><td><%= RedmineServerlessSes.global_address %></td></tr>
    <tr>
      <th>MX</th>
      <td>
        <% if @mx.nil? %><%= l(:text_serverless_mail_mx_unknown) %>
        <% elsif @mx.empty? %><%= l(:text_serverless_mail_mx_none) %>
        <% else %><%= @mx.join(', ') %><% end %>
      </td>
    </tr>
  </tbody>
</table>
<% if RedmineServerlessSes.per_project_addresses? && @project_settings.any? %>
<table class="list serverless-mail-projects">
  <thead><tr><th><%= l(:label_project) %></th><th><%= l(:field_mail) %></th><th><%= l(:label_serverless_mail_receive) %></th></tr></thead>
  <tbody>
  <% @project_settings.each do |setting| %>
    <tr>
      <td><%= link_to_project setting.project %></td>
      <td><%= setting.address %></td>
      <td><%= format_object(setting.receive?) %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<% end %>
<% end %>
<% unless RedmineServerlessSes.mail_bucket %>
  <p class="warning"><%= l(:text_serverless_mail_no_bucket) %></p>
<% end %>

<h3><%= l(:label_serverless_mail_received) %></h3>
<p>
  <%= link_to_unless params[:dropped] != '1', l(:label_all), action: 'index' %> |
  <%= link_to_unless params[:dropped] == '1', l(:label_serverless_mail_dropped_only), action: 'index', dropped: '1' %>
</p>
<% if @received.empty? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<%= form_tag(serverless_mail_reimport_path, id: 'serverless-received-mails') do %>
<table class="list">
  <thead>
    <tr>
      <th></th><th><%= l(:label_serverless_mail_received_at) %></th><th><%= l(:field_mail) %></th>
      <th><%= l(:field_subject) %></th><th><%= l(:label_project) %></th><th><%= l(:label_serverless_mail_verdicts) %></th>
      <th><%= l(:label_serverless_mail_result) %></th>
    </tr>
  </thead>
  <tbody>
  <% @received.each do |mail| %>
    <tr id="received-mail-<%= mail.id %>" class="<%= mail.status %>">
      <td><%= check_box_tag 'ids[]', mail.id, false, id: nil %></td>
      <td><%= format_time(mail.received_at || mail.created_at) %></td>
      <td><%= mail.mail_from %></td>
      <td><%= mail.subject %></td>
      <td><%= mail.project ? link_to_project(mail.project) : '' %></td>
      <td class="verdicts"><%= mail.verdicts.to_h.slice(:virus, :spam, :dmarc).map { |k, v| "#{k.to_s.upcase} #{v}" }.join(', ') %></td>
      <td>
        <% if mail.status == 'imported' %>
          <%= mail.issue_id ? link_to("##{mail.issue_id}", issue_path(mail.issue_id)) : l(:label_serverless_mail_imported) %>
        <% else %>
          <%= l(:"label_serverless_mail_reason_#{mail.reason}") %>
        <% end %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
<p><%= submit_tag l(:button_serverless_mail_reimport), data: { confirm: l(:text_are_you_sure) } %></p>
<% end %>
<% end %>

<h3><%= l(:label_serverless_mail_settings) %></h3>
<%= form_tag({ action: 'update' }, id: 'serverless-mail-settings') do %>
<div class="box tabular">
  <p>
    <%= label_tag 'settings_global_local_part', l(:label_serverless_mail_global_local_part) %>
    <%= text_field_tag 'settings[global_local_part]', @settings['global_local_part'], size: 20 %>@<%= @domain %>
  </p>
  <p>
    <%= label_tag 'settings_global_mail', l(:label_serverless_mail_global_mail) %>
    <%= select_tag 'settings[global_mail]',
                   options_for_select([[l(:label_serverless_mail_global_drop), 'drop'],
                                       [l(:label_serverless_mail_global_default_project), 'default_project']],
                                      @settings['global_mail']) %>
  </p>
  <p>
    <%= label_tag 'settings_default_project', l(:label_serverless_mail_default_project) %>
    <%= select_tag 'settings[default_project]',
                   options_for_select([['', '']] + Project.active.sorted.map { |p| [p.name, p.identifier] },
                                      @settings['default_project']) %>
  </p>
  <p>
    <%= label_tag 'settings_import_without_dmarc_pass', l(:label_serverless_mail_import_without_dmarc_pass) %>
    <%= hidden_field_tag 'settings[import_without_dmarc_pass]', '0', id: nil %>
    <%= check_box_tag 'settings[import_without_dmarc_pass]', '1', @settings['import_without_dmarc_pass'] == '1' %>
    <em class="info"><%= l(:text_serverless_mail_import_without_dmarc_pass) %></em>
  </p>
  <p>
    <%= label_tag 'settings_import_spam', l(:label_serverless_mail_import_spam) %>
    <%= hidden_field_tag 'settings[import_spam]', '0', id: nil %>
    <%= check_box_tag 'settings[import_spam]', '1', @settings['import_spam'] == '1' %>
    <em class="info"><%= l(:text_serverless_mail_import_spam) %></em>
  </p>
  <p><em class="info"><%= l(:text_serverless_mail_virus) %></em></p>
  <p>
    <%= label_tag 'settings_per_project_addresses', l(:label_serverless_mail_per_project) %>
    <%= hidden_field_tag 'settings[per_project_addresses]', '0', id: nil %>
    <%= check_box_tag 'settings[per_project_addresses]', '1', @settings['per_project_addresses'] == '1' %>
  </p>
  <p>
    <%= label_tag 'settings_project_senders', l(:label_serverless_mail_project_senders) %>
    <%= hidden_field_tag 'settings[project_senders]', '0', id: nil %>
    <%= check_box_tag 'settings[project_senders]', '1', @settings['project_senders'] == '1' %>
  </p>
</div>
<%= submit_tag l(:button_save) %>
<% end %>
