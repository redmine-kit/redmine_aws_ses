<%= render partial: 'aws_admin/tabs', locals: { selected: 'mail_sending' } %>
<%= render partial: 'aws_ses_mail_sending/updated', locals: { snapshot: @snapshot, tab: 'mail_sending' } %>
<% account = @snapshot&.section(:account) %>
<% identity = @snapshot&.section(:identity) %>

<h3><%= l(:label_aws_ses_mail_account) %></h3>

<p>
  <%= link_to sprite_icon('email', l(:label_send_test_email)), test_email_path, method: :post, class: 'icon icon-email' %>
  <% if respond_to?(:aws_sqs_jobs_path) %>
  | <%= link_to l(:label_aws_ses_mail_failed), aws_sqs_jobs_path(mail: '1') %>
  <% end %>
</p>

<% if @snapshot&.error(:account) %>
<div class="flash error"><%= l(:text_aws_ses_mail_api_error, error: @snapshot.error(:account)) %></div>
<% elsif account.nil? %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<%= render partial: 'aws_admin/values', locals: { rows: aws_ses_mail_account_rows(account) } %>
<% end %>

<h3><%= l(:label_aws_ses_mail_domain) %></h3>

<% if @domain.nil? %>
<p class="warning"><%= l(:text_aws_ses_mail_no_domain) %></p>
<% elsif @snapshot&.error(:identity) %>
<div class="flash error"><%= l(:text_aws_ses_mail_api_error, error: @snapshot.error(:identity)) %></div>
<% elsif identity.nil? %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
<%= render partial: 'aws_admin/values', locals: { rows: aws_ses_mail_identity_rows(@domain, identity) } %>
<% end %>

<h3><%= l(:label_aws_ses_mail_suppressed) %></h3>

<% suppressed = @snapshot&.suppressed.to_a %>
<% if @snapshot&.error(:suppressed) %>
<div class="flash error"><%= l(:text_aws_ses_mail_api_error, error: @snapshot.error(:suppressed)) %></div>
<% elsif suppressed.any? %>
<div class="autoscroll">
<table class="list suppressed"><thead>
<tr>
    <th><%= l(:field_mail) %></th>
    <th><%= l(:label_user) %></th>
    <th><%= l(:label_aws_ses_mail_reason) %></th>
    <th><%= l(:field_updated_on) %></th>
    <th></th>
</tr></thead>
<tbody>
<% suppressed.each do |destination| %>
<tr>
    <td class="name"><%= destination[:address] %></td>
    <td class="name"><%= destination[:user] %></td>
    <td><%= aws_ses_mail_value(:suppression_reason, destination[:reason]) %></td>
    <td><%= destination[:last_update] ? format_time(destination[:last_update]) : '' %></td>
    <td class="buttons">
      <%= link_to sprite_icon('del', l(:button_aws_ses_mail_unsuppress)), aws_ses_mail_unsuppress_path(address: destination[:address]),
                  method: :post, data: { confirm: l(:text_are_you_sure) }, class: 'icon icon-del' %>
    </td>
</tr>
<% end %>
</tbody>
</table>
</div>
<% else %>
<p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
